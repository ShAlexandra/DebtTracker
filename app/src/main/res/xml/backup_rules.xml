<?xml version="1.0" encoding="utf-8"?>
<!-- Токены и сохранённые логин/пароль не должны попадать в резервные копии (Android 11 и ниже). -->
<full-backup-content>
    <exclude domain="sharedpref" path="auth_tokens.xml" />
    <exclude domain="sharedpref" path="credentials.xml" />
</full-backup-content>
